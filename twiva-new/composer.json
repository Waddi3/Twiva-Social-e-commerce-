{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.0.2",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-xlswriter": "*",
    "apxcde/laravel-onfon-sms": "dev-main",
    "barryvdh/laravel-dompdf": "^2.1",
    "doctrine/dbal": "^3.4",
    "guzzlehttp/guzzle": "^7.2",
    "guzzlehttp/oauth-subscriber": "^0.6.0",
    "intervention/image": "^2.7",
    "kreait/firebase-php": "6.3.1",
    "kudashevs/laravel-share-buttons": "^4.0",
    "laravel-notification-channels/fcm": "~2.0",
    "laravel-notification-channels/twilio": "^3.2",
    "laravel/framework": "^9.11",
    "laravel/horizon": "^5.29",
    "laravel/passport": "^10.4",
    "laravel/sanctum": "^2.14.1",
    "laravel/socialite": "^5.5",
    "laravel/tinker": "^2.7",
    "laravel/ui": "^4.0",
    "maatwebsite/excel": "^3.1",
    "nwidart/laravel-modules": "^9.0",
    "propaganistas/laravel-phone": "^4.4",
    "psr/simple-cache": "^2.0",
    "sentry/sentry-laravel": "^3.8",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "socialiteproviders/facebook": "^4.1",
    "socialiteproviders/instagram": "^4.1",
    "socialiteproviders/instagram-basic": "^4.1",
    "socialiteproviders/tiktok": "^5.1",
    "socialiteproviders/twitter": "^4.1",
    "socialiteproviders/youtube": "^4.1",
    "staudenmeir/laravel-migration-views": "^1.0",
    "twilio/sdk": "^6.42"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "laravel/sail": "^1.0.1",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^6.1",
    "phpunit/phpunit": "^9.5.10",
    "spatie/laravel-ignition": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\": "Modules/"
    },
    "files": [
      "app/Http/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform-check": false,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
